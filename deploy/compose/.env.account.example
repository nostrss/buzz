# Account service secrets (fork-only). Copy to .env.account and replace every
# CHANGE_ME value. This file is loaded ONLY into the `account` container so the
# relay never sees the operator key or the master key.
#
# Back up this file with .env: losing ACCOUNT_MASTER_KEY makes every stored
# identity key unreadable and every member has to start over with a new one.

# Nostr secret key (64 hex) whose pubkey is listed in the relay's
# RELAY_OPERATOR_PUBKEYS. Generate: openssl rand -hex 32
ACCOUNT_OPERATOR_SECRET_KEY=CHANGE_ME_64_HEX_SECRET_KEY

# 32 random bytes, base64. Encrypts stored identity keys at rest.
# Generate: openssl rand -base64 32
ACCOUNT_MASTER_KEY=CHANGE_ME_BASE64_32_BYTES

# Resend (https://resend.com) API key and verified sender address.
RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY
ACCOUNT_EMAIL_FROM=noreply@buzz.example.com

# Communities are created as <name>.<this domain>. Must be covered by the
# wildcard DNS record and Caddy on-demand TLS (see README).
ACCOUNT_COMMUNITY_DOMAIN=app.buzz.example.com

# Scheme of the relay URL handed to desktop clients: wss (default) behind
# Caddy TLS; ws only for a local stack without TLS.
# ACCOUNT_RELAY_PUBLIC_SCHEME=wss
